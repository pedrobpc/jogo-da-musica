{
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "jogo-da-musica",
  "main": "worker.js",
  "compatibility_date": "2026-08-31",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}